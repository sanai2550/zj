# Actual terminal recording; API key is inherited, never typed or printed.
Output demo/demo.gif
Output demo/demo.mp4
Set Shell "zsh"
Set FontSize 22
Set Width 1280
Set Height 480
Set Theme "Catppuccin Mocha"
Set TypingSpeed 65ms
Set Framerate 20

Hide
Type 'source "$ZJ_DEMO_DIR/setup.zsh"'
Enter
Sleep 1s
Show
Sleep 2s

# Navigate to a folder never visited before. Enter accepts directly.
Type "zj go to java payments"
Sleep 2s
Enter
Sleep 1s
Type "pwd"
Enter
Sleep 2s

# Semantic selection from fabricated history, using the real Jev API.
Type "zj print all demo tests passed"
Sleep 3s
Enter
Sleep 3s
